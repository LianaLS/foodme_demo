{
  "mcpServers": {
    "qase": {
      "command": "cmd",
      "args": ["/c", "agentsecrets", "env", "--", "npx", "-y", "@qase/mcp-server"]
    },
    "agentsecrets": {
      "command": "cmd",
      "args": ["/c", "agentsecrets", "mcp", "serve"]
    },
        "playwright": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@playwright/mcp@latest"]
    }

  }
}
